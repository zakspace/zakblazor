@page "/docs/button"

<PageTitle>Button — ZAKBlazor Documentation</PageTitle>

<div class="docs-page">
    <div class="docs-header">
        <h1 class="docs-title">Button</h1>
        <p class="docs-subtitle">Buttons allow users to take actions, submit commands, and trigger UI state changes with clear visual feedback.</p>
        <div class="docs-badges">
            <ZakBadge Content="Component" Color="ZakColor.Primary" />
            <ZakBadge Content="Interactive" Color="ZakColor.Success" />
            <ZakBadge Content="WCAG AA" Color="ZakColor.Info" />
        </div>
    </div>

    <!-- Variants Section -->
    <div class="docs-section">
        <h2 class="docs-section-title">Variants</h2>
        <p class="docs-section-desc">Buttons provide 5 distinctive visual variants to establish clear visual hierarchy across actions.</p>
        <ZakDocsExample Title="Button Variants" Code="@VariantCode">
            <ZakStack Orientation="ZakOrientation.Horizontal" Align="ZakAlignment.Center" Spacing="3" Wrap="true">
                <ZakButton Variant="ZakVariant.Filled" Color="ZakColor.Primary">Filled</ZakButton>
                <ZakButton Variant="ZakVariant.Outlined" Color="ZakColor.Primary">Outlined</ZakButton>
                <ZakButton Variant="ZakVariant.Soft" Color="ZakColor.Primary">Soft</ZakButton>
                <ZakButton Variant="ZakVariant.Text" Color="ZakColor.Primary">Text</ZakButton> 
            </ZakStack>
        </ZakDocsExample>
    </div>

    <!-- Semantic Colors Section -->
    <div class="docs-section">
        <h2 class="docs-section-title">Colors</h2>
        <p class="docs-section-desc">Full suite of semantic theme colors tailored for primary actions, warnings, confirmations, and deletions.</p>
        <ZakDocsExample Title="Semantic Colors" Code="@ColorCode">
            <ZakStack Orientation="ZakOrientation.Horizontal" Align="ZakAlignment.Center" Spacing="3" Wrap="true">
                <ZakButton Color="ZakColor.Primary">Primary</ZakButton>
                <ZakButton Color="ZakColor.Secondary">Secondary</ZakButton>
                <ZakButton Color="ZakColor.Success">Success</ZakButton>
                <ZakButton Color="ZakColor.Warning">Warning</ZakButton>
                <ZakButton Color="ZakColor.Danger">Danger</ZakButton>
                <ZakButton Color="ZakColor.Info">Info</ZakButton>
                <ZakButton Color="ZakColor.Default">Default</ZakButton>
            </ZakStack>
        </ZakDocsExample>
    </div>

    <!-- Sizes Section -->
    <div class="docs-section">
        <h2 class="docs-section-title">Sizes</h2>
        <p class="docs-section-desc">Available in 5 sizes from compact table actions to high-visibility marketing buttons.</p>
        <ZakDocsExample Title="Sizes" Code="@SizeCode">
            <ZakStack Orientation="ZakOrientation.Horizontal" Align="ZakAlignment.Center" Spacing="3" Wrap="true">
                <ZakButton Size="ZakSize.ExtraSmall">Extra Small</ZakButton>
                <ZakButton Size="ZakSize.Small">Small</ZakButton>
                <ZakButton Size="ZakSize.Medium">Medium</ZakButton>
                <ZakButton Size="ZakSize.Large">Large</ZakButton>
                <ZakButton Size="ZakSize.ExtraLarge">Extra Large</ZakButton>
            </ZakStack>
        </ZakDocsExample>
    </div>

    <!-- Shapes Section -->
    <div class="docs-section">
        <h2 class="docs-section-title">Corner Shapes</h2>
        <p class="docs-section-desc">Control border curvature using predefined design tokens.</p>
        <ZakDocsExample Title="Corner Radius Shapes" Code="@ShapeCode">
            <ZakStack Orientation="ZakOrientation.Horizontal" Align="ZakAlignment.Center" Spacing="3" Wrap="true">
                <ZakButton Shape="ZakShape.Rounded">Rounded (Default)</ZakButton>
                <ZakButton Shape="ZakShape.Pill">Pill</ZakButton>
                <ZakButton Shape="ZakShape.Square">Square</ZakButton>
            </ZakStack>
        </ZakDocsExample>
    </div>

    <!-- Icons & Loading Section -->
    <div class="docs-section">
        <h2 class="docs-section-title">Icons &amp; Loading States</h2>
        <p class="docs-section-desc">Incorporate icons seamlessly with automatic optical alignment and interactive loading spinner transitions.</p>
        <ZakDocsExample Title="Icons and Loading" Code="@IconLoadingCode">
            <ZakStack Orientation="ZakOrientation.Horizontal" Align="ZakAlignment.Center" Spacing="3" Wrap="true">
                <ZakButton StartIcon="@ZakIcons.Download" Color="ZakColor.Primary">Download</ZakButton>
                <ZakButton EndIcon="@ZakIcons.ArrowRight" Variant="ZakVariant.Outlined" Color="ZakColor.Primary">Continue</ZakButton>
                <ZakButton StartIcon="@ZakIcons.Trash" Color="ZakColor.Danger" Variant="ZakVariant.Soft">Delete Item</ZakButton>
                <ZakButton Loading="@_isLoading" LoadingText="Saving..." OnClick="SimulateAsync">
                    Click to Save
                </ZakButton>
            </ZakStack>
        </ZakDocsExample>
    </div>

    <!-- Button Groups -->
    <div class="docs-section">
        <h2 class="docs-section-title">Button Groups</h2>
        <p class="docs-section-desc">Group related actions horizontally or vertically into unified segments.</p>
        <ZakDocsExample Title="Button Group" Code="@GroupCode">
            <ZakButtonGroup Variant="ZakVariant.Outlined" Color="ZakColor.Primary">
                <ZakButton>Day</ZakButton>
                <ZakButton>Week</ZakButton>
                <ZakButton>Month</ZakButton>
                <ZakButton>Year</ZakButton>
            </ZakButtonGroup>
        </ZakDocsExample>
    </div>

    <!-- API Reference -->
    <div class="docs-section">
        <ZakApiTable ComponentName="ZakButton" />
    </div>
</div>

@code {
    private bool _isLoading = false;

    private async Task SimulateAsync()
    {
        _isLoading = true;
        StateHasChanged();
        await Task.Delay(1800);
        _isLoading = false;
        StateHasChanged();
    }

    private const string VariantCode = @"<ZakButton Variant=""ZakVariant.Filled"" Color=""ZakColor.Primary"">Filled</ZakButton>
<ZakButton Variant=""ZakVariant.Outlined"" Color=""ZakColor.Primary"">Outlined</ZakButton>
<ZakButton Variant=""ZakVariant.Soft"" Color=""ZakColor.Primary"">Soft</ZakButton>
<ZakButton Variant=""ZakVariant.Text"" Color=""ZakColor.Primary"">Text</ZakButton>
<ZakButton Variant=""ZakVariant.Glass"" Color=""ZakColor.Primary"">Glass</ZakButton>";

    private const string ColorCode = @"<ZakButton Color=""ZakColor.Primary"">Primary</ZakButton>
<ZakButton Color=""ZakColor.Secondary"">Secondary</ZakButton>
<ZakButton Color=""ZakColor.Success"">Success</ZakButton>
<ZakButton Color=""ZakColor.Warning"">Warning</ZakButton>
<ZakButton Color=""ZakColor.Danger"">Danger</ZakButton>
<ZakButton Color=""ZakColor.Info"">Info</ZakButton>
<ZakButton Color=""ZakColor.Default"">Default</ZakButton>";

    private const string SizeCode = @"<ZakButton Size=""ZakSize.ExtraSmall"">Extra Small</ZakButton>
<ZakButton Size=""ZakSize.Small"">Small</ZakButton>
<ZakButton Size=""ZakSize.Medium"">Medium</ZakButton>
<ZakButton Size=""ZakSize.Large"">Large</ZakButton>
<ZakButton Size=""ZakSize.ExtraLarge"">Extra Large</ZakButton>";

    private const string ShapeCode = @"<ZakButton Shape=""ZakShape.Rounded"">Rounded</ZakButton>
<ZakButton Shape=""ZakShape.Pill"">Pill</ZakButton>
<ZakButton Shape=""ZakShape.Square"">Square</ZakButton>";

    private const string IconLoadingCode = @"<ZakButton StartIcon=""@ZakIcons.Download"" Color=""ZakColor.Primary"">Download</ZakButton>
<ZakButton EndIcon=""@ZakIcons.ArrowRight"" Variant=""ZakVariant.Outlined"">Continue</ZakButton>
<ZakButton Loading=""@_isLoading"" LoadingText=""Saving..."" OnClick=""SimulateAsync"">Click to Save</ZakButton>";

    private const string GroupCode = @"<ZakButtonGroup Variant=""ZakVariant.Outlined"" Color=""ZakColor.Primary"">
    <ZakButton>Day</ZakButton>
    <ZakButton>Week</ZakButton>
    <ZakButton>Month</ZakButton>
    <ZakButton>Year</ZakButton>
</ZakButtonGroup>";
}