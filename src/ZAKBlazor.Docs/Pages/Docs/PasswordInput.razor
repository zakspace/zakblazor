@page "/docs/password-input"

<PageTitle>Password Input — ZAKBlazor Documentation</PageTitle>

<div class="docs-page">
    <div class="docs-header">
        <h1 class="docs-title">Password Input</h1>
        <p class="docs-subtitle">Secure text input with built-in lock icon adornment and interactive show/hide password visibility toggle.</p>
        <div class="docs-badges">
            <ZakBadge Content="Form Control" Color="ZakColor.Primary" />
            <ZakBadge Content="Security" Color="ZakColor.Success" />
        </div>
    </div>

    <!-- Password Input with Toggle -->
    <div class="docs-section">
        <h2 class="docs-section-title">Standard Password Field</h2>
        <p class="docs-section-desc">Click the eye button on the right to toggle between masked and plain text.</p>
        <ZakDocsExample Title="Secure Password Field" Code="@PasswordCode">
            <div style="max-width: 360px;">
                <ZakPasswordInput Label="Account Password"
                                  Placeholder="Enter secure password..."
                                  HelperText="Must contain at least 8 characters."
                                  @bind-Value="_password" />
            </div>
        </ZakDocsExample>
    </div>

    <!-- Outlined Variant -->
    <div class="docs-section">
        <h2 class="docs-section-title">Outlined Variant</h2>
        <p class="docs-section-desc">Clean border outline style suitable for authentication screens.</p>
        <ZakDocsExample Title="Outlined Variant" Code="@OutlinedCode">
            <div style="max-width: 360px;">
                <ZakPasswordInput Label="Confirm Password"
                                  Variant="ZakVariant.Outlined"
                                  Placeholder="Repeat your password..." />
            </div>
        </ZakDocsExample>
    </div>

    <div class="docs-section">
        <ZakApiTable ComponentName="ZakPasswordInput" />
    </div>
</div>

@code {
    private string? _password;

    private const string PasswordCode = @"<ZakPasswordInput Label=""Account Password""
                  Placeholder=""Enter secure password...""
                  HelperText=""Must contain at least 8 characters.""
                  @bind-Value=""_password"" />";

    private const string OutlinedCode = @"<ZakPasswordInput Label=""Confirm Password""
                  Variant=""ZakVariant.Outlined""
                  Placeholder=""Repeat your password..."" />";
}
