@page "/docs/progress-linear"
@page "/docs/linear-progress"

<PageTitle>Linear Progress — ZAKBlazor Documentation</PageTitle>

<div class="docs-page">
    <div class="docs-header">
        <h1 class="docs-title">Linear Progress</h1>
        <p class="docs-subtitle">Horizontal progress indicator for determinate progress percentages, buffer streaming, or indeterminate loading bars.</p>
        <div class="docs-badges">
            <ZakBadge Content="Feedback" Color="ZakColor.Primary" />
            <ZakBadge Content="Progress" Color="ZakColor.Success" />
        </div>
    </div>

    <!-- Determinate & Indeterminate -->
    <div class="docs-section">
        <h2 class="docs-section-title">Determinate & Indeterminate</h2>
        <p class="docs-section-desc">Pass <code>Value</code> from 0 to 100 for determinate tracking, or <code>Indeterminate="true"</code> for continuous looping animations.</p>
        <ZakDocsExample Title="Linear Progress Bars" Code="@LinearCode">
            <ZakStack Orientation="ZakOrientation.Vertical" Spacing="4" Style="max-width: 500px;">
                <div>
                    <ZakText Typo="Typo.caption" GutterBottom="true">Determinate — 45%</ZakText>
                    <ZakProgressLinear Value="45" Color="ZakColor.Primary" Height="8" />
                </div>

                <div>
                    <ZakText Typo="Typo.caption" GutterBottom="true">With Buffer Streaming (Value 60%, Buffer 85%)</ZakText>
                    <ZakProgressLinear Value="60" Buffer="85" Color="ZakColor.Success" Height="8" />
                </div>

                <div>
                    <ZakText Typo="Typo.caption" GutterBottom="true">Indeterminate Task Running</ZakText>
                    <ZakProgressLinear Indeterminate="true" Color="ZakColor.Warning" Height="6" />
                </div>
            </ZakStack>
        </ZakDocsExample>
    </div>

    <div class="docs-section">
        <ZakApiTable ComponentName="ZakProgressLinear" />
    </div>
</div>

@code {
    private const string LinearCode = @"<ZakProgressLinear Value=""45"" Color=""ZakColor.Primary"" Height=""8"" />
<ZakProgressLinear Value=""60"" Buffer=""85"" Color=""ZakColor.Success"" Height=""8"" />
<ZakProgressLinear Indeterminate=""true"" Color=""ZakColor.Warning"" Height=""6"" />";
}
