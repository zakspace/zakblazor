@page "/docs/switch"

<PageTitle>Switch — ZAKBlazor Documentation</PageTitle>

<div class="docs-page">
    <div class="docs-header">
        <h1 class="docs-title">Switch</h1>
        <p class="docs-subtitle">Switches toggle the state of a single setting on or off immediately with smooth micro-animations.</p>
        <div class="docs-badges">
            <ZakBadge Content="Form Control" Color="ZakColor.Primary" />
            <ZakBadge Content="Animated" Color="ZakColor.Success" />
        </div>
    </div>

    <div class="docs-section">
        <h2 class="docs-section-title">Toggle Switches</h2>
        <p class="docs-section-desc">Supports label, color variants, and sizes.</p>
        <ZakDocsExample Title="Switches" Code="@SwitchCode">
            <ZakStack Orientation="ZakOrientation.Vertical" Spacing="3">
                <ZakSwitch @bind-Value="_notifications" Label="Push Notifications" Color="ZakColor.Primary" />
                <ZakSwitch @bind-Value="_autoSave" Label="Auto-save document drafts" Color="ZakColor.Success" />
                <ZakSwitch Value="false" Disabled="true" Label="Maintenance mode (locked)" />
            </ZakStack>
        </ZakDocsExample>
    </div>

    <div class="docs-section">
        <ZakApiTable ComponentName="ZakSwitch" />
    </div>
</div>

@code {
    private bool _notifications = true;
    private bool _autoSave = true;

    private const string SwitchCode = @"<ZakSwitch @bind-Value=""_notifications"" Label=""Push Notifications"" Color=""ZakColor.Primary"" />
<ZakSwitch @bind-Value=""_autoSave"" Label=""Auto-save document drafts"" Color=""ZakColor.Success"" />";
}
