@namespace ZAKBlazor.Docs.Layout
@inherits LayoutComponentBase
@inject IZakThemeService ThemeService
@inject IZakLayoutService LayoutService

<ZakThemeProvider Theme="_customTheme"></ZakThemeProvider>
<ZakDialogProvider />
<ZakSnackbarProvider />

<ZakLayout>
        <ZakAppBar Fixed="true" Elevation="1">
            <ZakStack Orientation="ZakOrientation.Horizontal" Align="ZakAlignment.Center" Spacing="3">
                <ZakIconButton Icon="@ZakIcons.Menu" AriaLabel="Toggle navigation menu"
                Variant="ZakVariant.Text" Color="ZakColor.Default" 
                OnClick="() => LayoutService.ToggleDrawer()" />
                <a href="/" class="zak-brand-link">
                    <div class="zak-brand-logo"><img src="images/logo-light.svg" alt="ZAKBlazor Logo" class="zak-brand-logo-image" /></div>
                    <div>
                        <span class="primary-text">ZAK</span> 
                        <span class="secondary-text">Blazor</span>
                    </div> 
                </a>
            </ZakStack> 
            <div class="zak-header-nav">
                <NavLink href="/" Match="NavLinkMatch.All">Overview</NavLink>
                <NavLink href="docs/installation">Docs</NavLink> 
                <NavLink href="icons">Icons</NavLink>
            </div>

            <ZakStack Orientation="ZakOrientation.Horizontal" Align="ZakAlignment.Center" Spacing="2">
                <ZakIconButton Icon="@ZakIcons.Search" Variant="ZakVariant.Text" Color="ZakColor.Default"
                 Size="ZakSize.Small" /> 
                <ZakIconButton Icon="@(ThemeService.IsDarkMode ? ZakIcons.Sun : ZakIcons.Moon)"
                    AriaLabel="Toggle dark mode" Variant="ZakVariant.Text" Color="ZakColor.Default"
                 Size="ZakSize.Small" OnClick="() => ThemeService.ToggleDarkModeAsync()" />

                 <ZakIconButton Icon="@ZakIcons.Github" Variant="ZakVariant.Text" Color="ZakColor.Default"
                 Size="ZakSize.Small" />
 
            </ZakStack>
        </ZakAppBar> 
     
        <ZakDrawer Width="280px" ClipMode="false" Class="zak-docs-sidebar" >
            <NavMenu />
        </ZakDrawer>

        <ZakMainContent>
            @Body
        </ZakMainContent>
    </ZakLayout>
@code{
 

    private ZakTheme _customTheme = new ZakTheme
    {
        PaletteLight = new ZakPaletteLight
        {
            Primary = "#8642d9",  
            PrimaryContrastText = "#FFFFFF", 
            Secondary = "#646464", 
            SecondaryContrastText = "#FFFFFF",
            // Adjust other palette variables
        },
        PaletteDark = new ZakPaletteDark
        {
            Primary = "#8642d9",  
            PrimaryContrastText = "#FFFFFF",
            Secondary = "#646464", 
            SecondaryContrastText = "#FFFFFF"
            // Adjust other palette variables
        },
        Typography = new ZakTypography{
            H1 = new ZakTypographyScale("2.5rem", "700", "1.2", "-0.025em"),
            H2 = new ZakTypographyScale("2rem", "700", "1.25", "-0.02em"),
            H3 = new ZakTypographyScale("1.625rem", "600", "1.3", "-0.015em"),
            H4 = new ZakTypographyScale("1.375rem", "600", "1.35", "-0.01em"),
            H5 = new ZakTypographyScale("1.125rem", "600", "1.4", "0"),
            H6 = new ZakTypographyScale("1rem", "600", "1.45", "0"),
            Subtitle1 = new ZakTypographyScale("1rem", "500", "1.5", "0"),
            Subtitle2 = new ZakTypographyScale("0.875rem", "500", "1.5", "0"),
            Body1 = new ZakTypographyScale("1rem", "400", "1.5", "0"),
            Body2 = new ZakTypographyScale("0.875rem", "400", "1.5", "0"),
            Caption = new ZakTypographyScale("0.75rem", "400", "1.4", "0"),
            Overline = new ZakTypographyScale("0.75rem", "600", "1.4", "0.08em", "uppercase"),
            Button = new ZakTypographyScale("0.875rem", "500", "1.5", "0.01em"),
        },

        Elevation = new ZakElevationTokens {
            Shadow0 = "none",
            Shadow1 = "0 1px 2px 0 rgba(0, 0, 0, 0.05)",
            Shadow2 = "0 1px 3px 0 rgba(0, 0, 0, 0.08), 0 1px 2px -1px rgba(0, 0, 0, 0.08)",
            Shadow3 = "0 4px 6px -1px rgba(0, 0, 0, 0.08), 0 2px 4px -2px rgba(0, 0, 0, 0.06)",
            Shadow4 = "0 10px 15px -3px rgba(0, 0, 0, 0.08), 0 4px 6px -4px rgba(0, 0, 0, 0.05)",
            Shadow5 = "0 10px 20px -3px rgba(0, 0, 0, 0.09), 0 4px 6px -4px rgba(0, 0, 0, 0.05)",
            Shadow6 = "0 12px 20px -4px rgba(0, 0, 0, 0.10), 0 4px 6px -2px rgba(0, 0, 0, 0.05)",
            Shadow8 = "0 16px 24px -4px rgba(0, 0, 0, 0.10), 0 8px 10px -6px rgba(0, 0, 0, 0.05)",
            Shadow12 = "0 20px 25px -5px rgba(0, 0, 0, 0.12), 0 8px 10px -6px rgba(0, 0, 0, 0.06)",
            Shadow16 = "0 25px 30px -5px rgba(0, 0, 0, 0.15), 0 10px 12px -6px rgba(0, 0, 0, 0.08)",
            Shadow24 = "0 25px 50px -12px rgba(0, 0, 0, 0.22)"  
        },

        Shape = new ZakShapeTokens{}, // Default shape tokens are defined in ZakTheme.cs

        Spacing = new ZakSpacingTokens{}, // Default spacing tokens are defined in ZakTheme.cs

        ZIndex = new ZakZIndexTokens{}, // Default z-index tokens are defined in ZakTheme.cs

    };
}