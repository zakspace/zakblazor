@namespace ZAKBlazor
@inherits ZAKBlazor.Primitives.ZakComponentBase

@if (IsVisible)
{
    <div class="zak-dialog-overlay @(BackdropBlur ? "zak-dialog-backdrop-blur" : "")"
         @onclick="HandleBackdropClickAsync"
         tabindex="-1"
         role="presentation">
        <div id="@ElementId"
             class="@CompiledClass"
             style="@CompiledStyle"
             role="dialog"
             aria-modal="true"
             aria-labelledby="@(HasTitle ? $"{ElementId}-title" : null)"
             @onclick:stopPropagation
             @attributes="AdditionalAttributes">

            @if (HasHeader)
            {
                <div class="zak-dialog-header">
                    @if (HeaderContent != null)
                    {
                        @HeaderContent
                    }
                    else if (!string.IsNullOrEmpty(Title))
                    {
                        <div id="@($"{ElementId}-title")" class="zak-dialog-title">@Title</div>
                    }

                    @if (ShowCloseButton)
                    {
                        <button type="button"
                                class="zak-dialog-close-btn"
                                aria-label="Close dialog"
                                @onclick="CloseAsync">
                            <ZakIcon Icon="@ZakIcons.Close" Size="ZakSize.Small" />
                        </button>
                    }
                </div>
            }

            <div class="zak-dialog-content">
                @ChildContent
            </div>

            @if (Actions != null)
            {
                <div class="zak-dialog-actions">
                    @Actions
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter]
    public bool IsVisible { get; set; }

    [Parameter]
    public EventCallback<bool> IsVisibleChanged { get; set; }

    [Parameter]
    public string? Title { get; set; }

    [Parameter]
    public RenderFragment? HeaderContent { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public RenderFragment? Actions { get; set; }

    [Parameter]
    public string MaxWidth { get; set; } = "560px";

    [Parameter]
    public bool FullWidth { get; set; } = true;

    [Parameter]
    public bool CloseOnBackdropClick { get; set; } = true;

    [Parameter]
    public bool ShowCloseButton { get; set; } = true;

    [Parameter]
    public bool BackdropBlur { get; set; } = true;

    [Parameter]
    public EventCallback OnClose { get; set; }

    private bool HasTitle => !string.IsNullOrEmpty(Title) || HeaderContent != null;
    private bool HasHeader => HasTitle || ShowCloseButton;

    private string? CompiledClass => CreateClassBuilder("zak-dialog")
        .AddClass("zak-dialog-fullwidth", FullWidth)
        .Build();

    private string? CompiledStyle => CreateStyleBuilder()
        .AddStyle("max-width", MaxWidth, !string.IsNullOrEmpty(MaxWidth))
        .Build();

    private async Task HandleBackdropClickAsync()
    {
        if (CloseOnBackdropClick)
        {
            await CloseAsync();
        }
    }

    public async Task CloseAsync()
    {
        IsVisible = false;
        if (IsVisibleChanged.HasDelegate)
        {
            await IsVisibleChanged.InvokeAsync(false);
        }
        if (OnClose.HasDelegate)
        {
            await OnClose.InvokeAsync();
        }
    }
}
