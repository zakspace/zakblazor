@namespace ZAKBlazor
@inherits ZAKBlazor.Primitives.ZakComponentBase

<div id="@ElementId"
     class="@CompiledClass"
     style="@CompiledStyle"
     @attributes="AdditionalAttributes">
    @ChildContent
</div>

@code {
    [Parameter]
    public int? Xs { get; set; }

    [Parameter]
    public int? Sm { get; set; }

    [Parameter]
    public int? Md { get; set; }

    [Parameter]
    public int? Lg { get; set; }

    [Parameter]
    public int? Xl { get; set; }

    [Parameter]
    public int? OffsetXs { get; set; }

    [Parameter]
    public int? OffsetSm { get; set; }

    [Parameter]
    public int? OffsetMd { get; set; }

    [Parameter]
    public int? OffsetLg { get; set; }

    [Parameter]
    public int? OffsetXl { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private string? CompiledClass => CreateClassBuilder("zak-col")
        .AddClass($"zak-col-xs-{Xs}", Xs.HasValue)
        .AddClass($"zak-col-sm-{Sm}", Sm.HasValue)
        .AddClass($"zak-col-md-{Md}", Md.HasValue)
        .AddClass($"zak-col-lg-{Lg}", Lg.HasValue)
        .AddClass($"zak-col-xl-{Xl}", Xl.HasValue)
        .AddClass($"zak-offset-xs-{OffsetXs}", OffsetXs.HasValue)
        .AddClass($"zak-offset-sm-{OffsetSm}", OffsetSm.HasValue)
        .AddClass($"zak-offset-md-{OffsetMd}", OffsetMd.HasValue)
        .AddClass($"zak-offset-lg-{OffsetLg}", OffsetLg.HasValue)
        .AddClass($"zak-offset-xl-{OffsetXl}", OffsetXl.HasValue)
        .AddClass("zak-col-auto", !Xs.HasValue && !Sm.HasValue && !Md.HasValue && !Lg.HasValue && !Xl.HasValue)
        .Build();

    private string? CompiledStyle => CreateStyleBuilder().Build();
}
