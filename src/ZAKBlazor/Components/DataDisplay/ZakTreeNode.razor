@namespace ZAKBlazor
@inherits ZAKBlazor.Primitives.ZakComponentBase

<li id="@ElementId"
    class="@CompiledClass"
    style="@CompiledStyle"
    @attributes="AdditionalAttributes">

    <div class="zak-tree-node-row" @onclick="ToggleExpanded">
        @if (ChildContent != null)
        {
            <span class="zak-tree-node-expander @(_expanded ? "expanded" : "")">
                <ZakIcon Icon="@ZakIcons.ChevronRight" Size="ZakSize.ExtraSmall" />
            </span>
        }
        else
        {
            <span class="zak-tree-node-expander zak-tree-node-leaf"></span>
        }

        @if (!string.IsNullOrEmpty(Icon))
        {
            <ZakIcon Icon="@Icon" Size="ZakSize.Small" Class="zak-tree-node-icon" />
        }

        <span class="zak-tree-node-label @(Selected ? "zak-tree-node-selected" : "")">
            @Text
        </span>
    </div>

    @if (ChildContent != null && _expanded)
    {
        <ul class="zak-tree zak-tree-nested">
            @ChildContent
        </ul>
    }
</li>

@code {
    private bool _expanded;

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public string? Text { get; set; }

    [Parameter]
    public string? Icon { get; set; }

    [Parameter]
    public bool Selected { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public bool DefaultExpanded { get; set; }

    [Parameter]
    public EventCallback OnSelected { get; set; }

    protected override void OnInitialized()
    {
        _expanded = DefaultExpanded;
    }

    private async Task ToggleExpanded()
    {
        if (ChildContent != null)
            _expanded = !_expanded;
        if (OnSelected.HasDelegate)
            await OnSelected.InvokeAsync();
    }

    private string? CompiledClass => CreateClassBuilder("zak-tree-node")
        .AddClass("zak-tree-node-disabled", Disabled)
        .Build();

    private string? CompiledStyle => CreateStyleBuilder().Build();
}
