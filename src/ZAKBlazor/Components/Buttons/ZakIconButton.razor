@namespace ZAKBlazor
@inherits ZAKBlazor.Primitives.ZakComponentBase

@if (!string.IsNullOrEmpty(Href) && !Disabled)
{
    <a id="@ElementId"
       class="@CompiledClass"
       style="@CompiledStyle"
       href="@Href"
       target="@Target"
       role="button"
       aria-label="@AriaLabel"
       title="@Title"
       @onclick="HandleClickAsync"
       @attributes="AdditionalAttributes">
        @RenderInner()
    </a>
}
else
{
    <button id="@ElementId"
            type="@Type"
            class="@CompiledClass"
            style="@CompiledStyle"
            disabled="@(Disabled || Loading)"
            aria-label="@AriaLabel"
            title="@Title"
            aria-busy="@(Loading ? "true" : null)"
            aria-disabled="@(Disabled ? "true" : null)"
            @onclick="HandleClickAsync"
            @attributes="AdditionalAttributes">
        @RenderInner()
    </button>
}

@code {
    [Parameter]
    public string? Icon { get; set; }

    [Parameter]
    public ZakVariant Variant { get; set; } = ZakVariant.Text;

    [Parameter]
    public ZakColor Color { get; set; } = ZakColor.Default;

    [Parameter]
    public ZakSize Size { get; set; } = ZakSize.Medium;

    [Parameter]
    public ZakShape Shape { get; set; } = ZakShape.Circle;

    [Parameter]
    public string? AriaLabel { get; set; }

    [Parameter]
    public string? Title { get; set; }

    [Parameter]
    public bool Loading { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public string? Href { get; set; }

    [Parameter]
    public string? Target { get; set; }

    [Parameter]
    public string Type { get; set; } = "button";

    [Parameter]
    public EventCallback<MouseEventArgs> OnClick { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private string? CompiledClass => CreateClassBuilder("zak-icon-btn")
        .AddClass(Variant.ToCssClass())
        .AddClass(Color.ToCssClass())
        .AddClass(Size.ToCssClass())
        .AddClass(Shape.ToCssClass())
        .AddClass("zak-disabled", Disabled)
        .AddClass("zak-loading", Loading)
        .Build();

    private string? CompiledStyle => CreateStyleBuilder().Build();

    private async Task HandleClickAsync(MouseEventArgs args)
    {
        if (Disabled || Loading) return;
        await OnClick.InvokeAsync(args);
    }

    private RenderFragment RenderInner() => @<text>
        @if (Loading)
        {
            <span class="zak-btn-spinner" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <circle cx="12" cy="12" r="10" stroke-dasharray="32" stroke-dashoffset="12" />
                </svg>
            </span>
        }
        else if (!string.IsNullOrEmpty(Icon))
        {
            <ZakIcon Icon="@Icon" Size="@ResolveIconSize(Size)" />
        }
        else
        {
            @ChildContent
        }
    </text>;

    private static ZakSize ResolveIconSize(ZakSize size) => size switch
    {
        ZakSize.ExtraSmall => ZakSize.ExtraSmall,
        ZakSize.Small => ZakSize.Small,
        ZakSize.Medium => ZakSize.Medium,
        ZakSize.Large => ZakSize.Large,
        ZakSize.ExtraLarge => ZakSize.ExtraLarge,
        _ => ZakSize.Medium
    };
}
