@namespace ZAKBlazor
@inherits ZAKBlazor.Primitives.ZakComponentBase

<div id="@ElementId"
     role="group"
     class="@CompiledClass"
     style="@CompiledStyle"
     @attributes="AdditionalAttributes">
    @ChildContent
</div>

@code {
    [Parameter]
    public ZakVariant Variant { get; set; } = ZakVariant.Filled;

    [Parameter]
    public ZakColor Color { get; set; } = ZakColor.Primary;

    [Parameter]
    public ZakSize Size { get; set; } = ZakSize.Medium;

    [Parameter]
    public ZakOrientation Orientation { get; set; } = ZakOrientation.Horizontal;

    [Parameter]
    public bool FullWidth { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private string? CompiledClass => CreateClassBuilder("zak-btn-group")
        .AddClass(Variant.ToCssClass())
        .AddClass(Color.ToCssClass())
        .AddClass(Size.ToCssClass())
        .AddClass(Orientation == ZakOrientation.Vertical ? "zak-btn-group-vertical" : "zak-btn-group-horizontal")
        .AddClass("zak-btn-group-full-width", FullWidth)
        .AddClass("zak-disabled", Disabled)
        .Build();

    private string? CompiledStyle => CreateStyleBuilder().Build();
}
