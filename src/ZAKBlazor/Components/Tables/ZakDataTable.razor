@namespace ZAKBlazor
@typeparam TItem
@implements IZakColumnHost<TItem>
@inherits ZAKBlazor.Primitives.ZakComponentBase

<CascadingValue Value="this" IsFixed="true">
    @Columns
</CascadingValue>

<div class="zak-table-container @(StickyHeader ? "zak-table-sticky-header" : "")">
    <table id="@ElementId"
           class="@CompiledClass"
           style="@CompiledStyle"
           @attributes="AdditionalAttributes">
        <thead>
            <tr>
                @if (DetailTemplate != null)
                {
                    <th style="width: 36px;"></th>
                }
                @if (Selectable)
                {
                    <th class="zak-table-cell-checkbox">
                        <ZakCheckbox Value="@IsAllSelected"
                                     ValueChanged="HandleSelectAllChangedAsync"
                                     AriaLabel="Select all rows" />
                    </th>
                }

                @foreach (var col in _columns)
                {
                    var isCurrentSort = _sortColumn == col;
                    <th class="@(col.Sortable ? "zak-table-th-sortable" : "") @(isCurrentSort ? "zak-table-sort-active" : "")"
                        style="@(col.Width != null ? $"width:{col.Width};" : "")"
                        @onclick="() => HandleSortAsync(col)">
                        <div class="zak-table-th-content">
                            <span>@(col.Title ?? col.Field)</span>
                            @if (col.Sortable)
                            {
                                <span class="zak-table-sort-icon" aria-hidden="true">
                                    <ZakIcon Icon="@(isCurrentSort && _sortDescending ? ZakIcons.ChevronDown : ZakIcons.ChevronUp)"
                                             Size="ZakSize.ExtraSmall" />
                                </span>
                            }
                        </div>
                    </th>
                }
            </tr>
        </thead>
        <tbody>
            @if (ProcessedItems.Any())
            {
                @foreach (var item in PageItems)
                {
                    var isSelected = SelectedItems.Contains(item);
                    var isExpanded = _expandedItems.Contains(item);

                    <tr class="@(isSelected ? "zak-row-selected" : "")"
                        @onclick="() => HandleRowClickAsync(item)">
                        @if (DetailTemplate != null)
                        {
                            <td style="width: 36px; text-align: center;">
                                <button type="button"
                                        class="zak-input-action"
                                        style="transform: rotate(@(isExpanded ? "90deg" : "0deg")); transition: transform 0.2s;"
                                        aria-label="@(isExpanded ? "Collapse row" : "Expand row")"
                                        @onclick:stopPropagation="true"
                                        @onclick="() => ToggleDetail(item)">
                                    <ZakIcon Icon="@ZakIcons.ChevronRight" Size="ZakSize.ExtraSmall" />
                                </button>
                            </td>
                        }
                        @if (Selectable)
                        {
                            <td class="zak-table-cell-checkbox" @onclick:stopPropagation="true">
                                <ZakCheckbox Value="@isSelected"
                                             ValueChanged="(b) => HandleRowSelectionChangedAsync(item, b)"
                                             AriaLabel="Select row" />
                            </td>
                        }

                        @foreach (var col in _columns)
                        {
                            <td style="@ResolveAlignment(col.Align)">
                                @if (col.Template != null)
                                {
                                    @col.Template(item)
                                }
                                else if (col.Property != null)
                                {
                                    @col.Property(item)?.ToString()
                                }
                                else if (!string.IsNullOrEmpty(col.Field))
                                {
                                    @GetPropertyValue(item, col.Field)
                                }
                            </td>
                        }
                    </tr>

                    @if (DetailTemplate != null && isExpanded)
                    {
                        <tr class="zak-table-detail-row">
                            <td colspan="@TotalColSpan">
                                @DetailTemplate(item)
                            </td>
                        </tr>
                    }
                }
            }
            else
            {
                <tr>
                    <td colspan="@TotalColSpan" class="zak-table-empty">
                        @if (EmptyContent != null)
                        {
                            @EmptyContent
                        }
                        else
                        {
                            <ZakText Typo="Typo.body2">@EmptyText</ZakText>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (Paginated && ProcessedItems.Any())
{
    <div style="padding: 0.75rem 1rem; border: 1px solid var(--zak-border); border-top: none; background: var(--zak-surface); border-radius: 0 0 var(--zak-radius-md) var(--zak-radius-md);">
        <ZakPagination TotalItems="@ProcessedItems.Count()"
                       PageSize="@PageSize"
                       PageSizeChanged="HandlePageSizeChanged"
                       CurrentPage="@_currentPage"
                       CurrentPageChanged="HandleCurrentPageChanged"
                       ShowPageSize="@ShowPageSizeOptions"
                       ShowInfo="true" />
    </div>
}

@code {
    private readonly List<ZakTableColumn<TItem>> _columns = new();
    private readonly HashSet<TItem> _expandedItems = new();
    private ZakTableColumn<TItem>? _sortColumn;
    private bool _sortDescending;
    private int _currentPage = 1;

    [Parameter]
    public IEnumerable<TItem>? Items { get; set; }

    [Parameter]
    public RenderFragment? Columns { get; set; }

    [Parameter]
    public RenderFragment<TItem>? DetailTemplate { get; set; }

    [Parameter]
    public RenderFragment? EmptyContent { get; set; }

    [Parameter]
    public string EmptyText { get; set; } = "No matching records found.";

    [Parameter]
    public bool Striped { get; set; }

    [Parameter]
    public bool Bordered { get; set; }

    [Parameter]
    public bool Hoverable { get; set; } = true;

    [Parameter]
    public bool Compact { get; set; }

    [Parameter]
    public bool StickyHeader { get; set; }

    [Parameter]
    public bool Selectable { get; set; }

    [Parameter]
    public HashSet<TItem> SelectedItems { get; set; } = new();

    [Parameter]
    public EventCallback<HashSet<TItem>> SelectedItemsChanged { get; set; }

    [Parameter]
    public EventCallback<TItem> OnRowClick { get; set; }

    [Parameter]
    public bool Paginated { get; set; }

    [Parameter]
    public int PageSize { get; set; } = 10;

    [Parameter]
    public bool ShowPageSizeOptions { get; set; } = true;

    public void RegisterColumn(ZakTableColumn<TItem> column)
    {
        if (!_columns.Contains(column))
        {
            _columns.Add(column);
            StateHasChanged();
        }
    }

    public void UnregisterColumn(ZakTableColumn<TItem> column)
    {
        _columns.Remove(column);
        StateHasChanged();
    }

    private int TotalColSpan => _columns.Count + (Selectable ? 1 : 0) + (DetailTemplate != null ? 1 : 0);

    private bool IsAllSelected =>
        ProcessedItems.Any() && ProcessedItems.All(i => SelectedItems.Contains(i));

    private IEnumerable<TItem> ProcessedItems
    {
        get
        {
            if (Items == null) return Enumerable.Empty<TItem>();
            var query = Items;

            if (_sortColumn != null)
            {
                if (_sortColumn.Property != null)
                {
                    query = _sortDescending
                        ? query.OrderByDescending(_sortColumn.Property)
                        : query.OrderBy(_sortColumn.Property);
                }
                else if (!string.IsNullOrEmpty(_sortColumn.Field))
                {
                    query = _sortDescending
                        ? query.OrderByDescending(i => GetPropertyValue(i, _sortColumn.Field))
                        : query.OrderBy(i => GetPropertyValue(i, _sortColumn.Field));
                }
            }

            return query;
        }
    }

    private IEnumerable<TItem> PageItems
    {
        get
        {
            var processed = ProcessedItems;
            if (!Paginated) return processed;
            return processed.Skip((_currentPage - 1) * PageSize).Take(PageSize);
        }
    }

    private string? CompiledClass => CreateClassBuilder("zak-table")
        .AddClass("zak-table-striped", Striped)
        .AddClass("zak-table-bordered", Bordered)
        .AddClass("zak-table-hoverable", Hoverable)
        .AddClass("zak-table-compact", Compact)
        .Build();

    private string? CompiledStyle => CreateStyleBuilder().Build();

    private static string ResolveAlignment(ZakAlignment align) => align switch
    {
        ZakAlignment.Center => "text-align: center;",
        ZakAlignment.End => "text-align: right;",
        _ => "text-align: left;"
    };

    private static object? GetPropertyValue(TItem item, string propertyName)
    {
        if (item == null) return null;
        var prop = typeof(TItem).GetProperty(propertyName);
        return prop?.GetValue(item);
    }

    private async Task HandleSortAsync(ZakTableColumn<TItem> col)
    {
        if (!col.Sortable) return;
        if (_sortColumn == col)
        {
            _sortDescending = !_sortDescending;
        }
        else
        {
            _sortColumn = col;
            _sortDescending = false;
        }
    }

    private void ToggleDetail(TItem item)
    {
        if (_expandedItems.Contains(item))
            _expandedItems.Remove(item);
        else
            _expandedItems.Add(item);
    }

    private async Task HandleRowClickAsync(TItem item)
    {
        if (OnRowClick.HasDelegate)
        {
            await OnRowClick.InvokeAsync(item);
        }
    }

    private async Task HandleRowSelectionChangedAsync(TItem item, bool isSelected)
    {
        if (isSelected)
            SelectedItems.Add(item);
        else
            SelectedItems.Remove(item);

        await SelectedItemsChanged.InvokeAsync(SelectedItems);
    }

    private async Task HandleSelectAllChangedAsync(bool isAllSelected)
    {
        if (isAllSelected)
        {
            foreach (var item in ProcessedItems)
            {
                SelectedItems.Add(item);
            }
        }
        else
        {
            SelectedItems.Clear();
        }

        await SelectedItemsChanged.InvokeAsync(SelectedItems);
    }

    private void HandleCurrentPageChanged(int page)
    {
        _currentPage = page;
    }

    private void HandlePageSizeChanged(int size)
    {
        PageSize = size;
        _currentPage = 1;
    }
}
