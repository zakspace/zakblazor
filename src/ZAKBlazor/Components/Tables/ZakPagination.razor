@namespace ZAKBlazor
@inherits ZAKBlazor.Primitives.ZakComponentBase

<nav id="@ElementId"
     aria-label="Pagination"
     class="@CompiledClass"
     style="@CompiledStyle"
     @attributes="AdditionalAttributes">
    @if (ShowInfo && TotalItems > 0)
    {
        <span class="zak-pagination-info">
            Showing <strong>@StartItem</strong> to <strong>@EndItem</strong> of <strong>@TotalItems</strong> entries
        </span>
    }

    <ul class="zak-pagination-list">
        <li>
            <button type="button"
                    class="zak-pagination-btn"
                    disabled="@(CurrentPage <= 1)"
                    aria-label="Previous page"
                    @onclick="() => GoToPageAsync(CurrentPage - 1)">
                <ZakIcon Icon="@ZakIcons.ChevronLeft" Size="ZakSize.ExtraSmall" />
            </button>
        </li>

        @foreach (var pageNumber in GetVisiblePages())
        {
            if (pageNumber == -1)
            {
                <li class="zak-pagination-ellipsis" aria-hidden="true">&hellip;</li>
            }
            else
            {
                var p = pageNumber;
                <li>
                    <button type="button"
                            class="zak-pagination-btn @(CurrentPage == p ? "active" : "")"
                            aria-current="@(CurrentPage == p ? "page" : null)"
                            @onclick="() => GoToPageAsync(p)">
                        @p
                    </button>
                </li>
            }
        }

        <li>
            <button type="button"
                    class="zak-pagination-btn"
                    disabled="@(CurrentPage >= TotalPages)"
                    aria-label="Next page"
                    @onclick="() => GoToPageAsync(CurrentPage + 1)">
                <ZakIcon Icon="@ZakIcons.ChevronRight" Size="ZakSize.ExtraSmall" />
            </button>
        </li>
    </ul>

    @if (ShowPageSize && PageSizeOptions != null && PageSizeOptions.Length > 0)
    {
        <select class="zak-pagination-size-select" value="@PageSize" @onchange="HandlePageSizeChangeAsync">
            @foreach (var opt in PageSizeOptions)
            {
                <option value="@opt">@opt / page</option>
            }
        </select>
    }
</nav>

@code {
    [Parameter]
    public int TotalItems { get; set; }

    [Parameter]
    public int PageSize { get; set; } = 10;

    [Parameter]
    public int CurrentPage { get; set; } = 1;

    [Parameter]
    public EventCallback<int> CurrentPageChanged { get; set; }

    [Parameter]
    public EventCallback<int> PageSizeChanged { get; set; }

    [Parameter]
    public int[]? PageSizeOptions { get; set; } = [10, 25, 50, 100];

    [Parameter]
    public bool ShowPageSize { get; set; }

    [Parameter]
    public bool ShowInfo { get; set; } = true;

    [Parameter]
    public int MaxVisiblePages { get; set; } = 5;

    public int TotalPages => Math.Max(1, (int)Math.Ceiling((double)TotalItems / (PageSize > 0 ? PageSize : 10)));

    public int StartItem => TotalItems == 0 ? 0 : (CurrentPage - 1) * PageSize + 1;

    public int EndItem => Math.Min(CurrentPage * PageSize, TotalItems);

    private string? CompiledClass => CreateClassBuilder("zak-pagination").Build();
    private string? CompiledStyle => CreateStyleBuilder().Build();

    private async Task GoToPageAsync(int page)
    {
        if (page < 1 || page > TotalPages || page == CurrentPage) return;
        CurrentPage = page;
        await CurrentPageChanged.InvokeAsync(page);
    }

    private async Task HandlePageSizeChangeAsync(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var newSize) && newSize > 0)
        {
            PageSize = newSize;
            CurrentPage = 1;
            await PageSizeChanged.InvokeAsync(newSize);
            await CurrentPageChanged.InvokeAsync(1);
        }
    }

    private IEnumerable<int> GetVisiblePages()
    {
        var total = TotalPages;
        if (total <= MaxVisiblePages)
        {
            for (var i = 1; i <= total; i++) yield return i;
            yield break;
        }

        yield return 1;

        var start = Math.Max(2, CurrentPage - 1);
        var end = Math.Min(total - 1, CurrentPage + 1);

        if (start > 2) yield return -1; // Ellipsis

        for (var i = start; i <= end; i++) yield return i;

        if (end < total - 1) yield return -1; // Ellipsis

        yield return total;
    }
}
