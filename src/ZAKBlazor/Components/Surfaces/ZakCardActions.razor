@namespace ZAKBlazor
@inherits ZAKBlazor.Primitives.ZakComponentBase

<div id="@ElementId"
     class="@CompiledClass"
     style="@CompiledStyle"
     @attributes="AdditionalAttributes">
    @ChildContent
</div>

@code {
    [Parameter]
    public ZakJustify Justify { get; set; } = ZakJustify.End;

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private string? CompiledClass => CreateClassBuilder("zak-card-actions")
        .AddClass(Justify.ToCssClass())
        .Build();

    private string? CompiledStyle => CreateStyleBuilder().Build();
}
