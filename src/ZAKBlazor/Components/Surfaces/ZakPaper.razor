@namespace ZAKBlazor
@inherits ZAKBlazor.Primitives.ZakComponentBase

<div id="@ElementId"
     class="@CompiledClass"
     style="@CompiledStyle"
     @attributes="AdditionalAttributes">
    @ChildContent
</div>

@code {
    [Parameter]
    public int Elevation { get; set; } = 1;

    [Parameter]
    public ZakShape Shape { get; set; } = ZakShape.Default;

    [Parameter]
    public bool Outlined { get; set; }

    [Parameter]
    public bool Square { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private string? CompiledClass => CreateClassBuilder("zak-paper")
        .AddClass(Elevation.ToCssClass(), !Outlined)
        .AddClass("zak-paper-outlined", Outlined)
        .AddClass("zak-shape-square", Square)
        .AddClass(Shape.ToCssClass(), !Square)
        .Build();

    private string? CompiledStyle => CreateStyleBuilder().Build();
}
