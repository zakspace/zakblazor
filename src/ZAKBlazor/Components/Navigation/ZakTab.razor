@namespace ZAKBlazor
@inherits ZAKBlazor.Primitives.ZakComponentBase

<button id="@ElementId"
        type="button"
        role="tab"
        aria-selected="@(IsActive ? "true" : "false")"
        aria-disabled="@(Disabled ? "true" : null)"
        disabled="@Disabled"
        tabindex="@(IsActive ? 0 : -1)"
        class="@CompiledClass"
        style="@CompiledStyle"
        @onclick="HandleClickAsync"
        @attributes="AdditionalAttributes">
    @if (!string.IsNullOrEmpty(Icon))
    {
        <ZakIcon Icon="@Icon" Size="ZakSize.Small" Class="zak-tab-icon" />
    }

    @if (!string.IsNullOrEmpty(Label))
    {
        <span class="zak-tab-label">@Label</span>
    }
    else
    {
        @ChildContent
    }

    @if (Badge != null)
    {
        <span class="zak-tab-badge">@Badge</span>
    }
</button>

@code {
    [CascadingParameter]
    public ZakTabs? Parent { get; set; }

    [Parameter]
    public string? Label { get; set; }

    [Parameter]
    public string? Icon { get; set; }

    [Parameter]
    public object? Badge { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private bool IsActive => Parent != null && Parent.GetTabIndex(this) == Parent.ActiveIndex;

    protected override void OnInitialized()
    {
        Parent?.RegisterTab(this);
    }

    private async Task HandleClickAsync()
    {
        if (Disabled || Parent == null) return;
        var idx = Parent.GetTabIndex(this);
        if (idx >= 0)
        {
            await Parent.SelectTabAsync(idx);
        }
    }

    private string? CompiledClass => CreateClassBuilder("zak-tab")
        .AddClass("zak-tab-active", IsActive)
        .AddClass("zak-disabled", Disabled)
        .Build();

    private string? CompiledStyle => CreateStyleBuilder().Build();

    protected override void Dispose(bool disposing)
    {
        if (disposing)
        {
            Parent?.UnregisterTab(this);
        }
        base.Dispose(disposing);
    }
}
