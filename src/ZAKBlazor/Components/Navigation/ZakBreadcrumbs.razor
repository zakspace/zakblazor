@namespace ZAKBlazor
@inherits ZAKBlazor.Primitives.ZakComponentBase

<nav id="@ElementId"
     aria-label="Breadcrumb"
     class="@CompiledClass"
     style="@CompiledStyle"
     @attributes="AdditionalAttributes">
    <ol class="zak-breadcrumbs-list">
        <CascadingValue Value="this" IsFixed="true">
            @ChildContent
        </CascadingValue>
    </ol>
</nav>

@code {
    private readonly List<ZakBreadcrumbItem> _items = new();

    [Parameter]
    public string? Separator { get; set; }

    [Parameter]
    public string? SeparatorIcon { get; set; } = ZakIcons.ChevronRight;

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    internal void Register(ZakBreadcrumbItem item)
    {
        if (!_items.Contains(item))
        {
            _items.Add(item);
        }
    }

    internal void Unregister(ZakBreadcrumbItem item)
    {
        _items.Remove(item);
    }

    internal bool IsFirst(ZakBreadcrumbItem item) => _items.Count > 0 && _items[0] == item;

    private string? CompiledClass => CreateClassBuilder("zak-breadcrumbs").Build();
    private string? CompiledStyle => CreateStyleBuilder().Build();
}
