@namespace ZAKBlazor
@typeparam TValue

<option value="@Value?.ToString()" disabled="@Disabled">
    @if (!string.IsNullOrEmpty(Text))
    {
        @Text
    }
    else
    {
        @ChildContent
    }
</option>

@code {
    [Parameter]
    public TValue? Value { get; set; }

    [Parameter]
    public string? Text { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
