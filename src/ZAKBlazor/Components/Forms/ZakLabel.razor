@namespace ZAKBlazor
@inherits ZAKBlazor.Primitives.ZakComponentBase

<label id="@ElementId"
       for="@For"
       class="@CompiledClass"
       style="@CompiledStyle"
       @attributes="AdditionalAttributes">
    @if (!string.IsNullOrEmpty(Text))
    {
        @Text
    }
    else
    {
        @ChildContent
    }
</label>

@code {
    [Parameter]
    public string? For { get; set; }

    [Parameter]
    public string? Text { get; set; }

    [Parameter]
    public bool Required { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private string? CompiledClass => CreateClassBuilder("zak-label")
        .AddClass("zak-label-required", Required)
        .Build();

    private string? CompiledStyle => CreateStyleBuilder().Build();
}
