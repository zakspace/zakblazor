@namespace ZAKBlazor
@inherits ZAKBlazor.Primitives.ZakInputBase<string>

<div class="zak-form-field">
    @if (!string.IsNullOrEmpty(Label))
    {
        <ZakLabel For="@ElementId" Required="@Required" Text="@Label" />
    }

    <div class="@CompiledWrapperClass" style="@CompiledStyle">
        <textarea id="@ElementId"
                  class="zak-input zak-textarea"
                  rows="@Rows"
                  cols="@Cols"
                  value="@Value"
                  placeholder="@Placeholder"
                  disabled="@Disabled"
                  readonly="@ReadOnly"
                  maxlength="@MaxLength"
                  required="@Required"
                  aria-invalid="@(HasError ? "true" : "false")"
                  @oninput="HandleInputAsync"
                  @onchange="HandleChangeAsync"
                  @attributes="AdditionalAttributes"></textarea>
    </div>

    <div style="display: flex; justify-content: space-between; align-items: flex-start;">
        <div>
            @if (HasError && !string.IsNullOrEmpty(ValidationErrorMessage))
            {
                <span class="zak-error-text" role="alert">
                    <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10" />
                        <line x1="12" y1="8" x2="12" y2="12" />
                        <line x1="12" y1="16" x2="12.01" y2="16" />
                    </svg>
                    @ValidationErrorMessage
                </span>
            }
            else if (!string.IsNullOrEmpty(HelperText))
            {
                <span class="zak-helper-text">@HelperText</span>
            }
        </div>

        @if (ShowCount || MaxLength.HasValue)
        {
            <span class="zak-helper-text" style="margin-left: auto;">
                @(Value?.Length ?? 0)@(MaxLength.HasValue ? $" / {MaxLength.Value}" : "")
            </span>
        }
    </div>
</div>

@code {
    [Parameter]
    public int Rows { get; set; } = 4;

    [Parameter]
    public int? Cols { get; set; }

    [Parameter]
    public int? MaxLength { get; set; }

    [Parameter]
    public bool ShowCount { get; set; }

    private string? CompiledWrapperClass => CreateClassBuilder("zak-input-wrapper zak-textarea-wrapper")
        .AddClass(Variant.ToCssClass())
        .AddClass(Color.ToCssClass())
        .AddClass("zak-input-error", HasError)
        .AddClass("zak-disabled", Disabled)
        .Build();

    private string? CompiledStyle => CreateStyleBuilder().Build();

    private async Task HandleInputAsync(ChangeEventArgs e)
    {
        await SetCurrentValueAsync(e.Value?.ToString());
    }

    private async Task HandleChangeAsync(ChangeEventArgs e)
    {
        await SetCurrentValueAsync(e.Value?.ToString());
    }
}
