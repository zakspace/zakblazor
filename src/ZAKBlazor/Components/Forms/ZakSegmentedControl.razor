@namespace ZAKBlazor
@typeparam TValue
@inherits ZAKBlazor.Primitives.ZakComponentBase

<div id="@ElementId"
     role="radiogroup"
     aria-label="@AriaLabel"
     class="@CompiledClass"
     style="@CompiledStyle"
     @attributes="AdditionalAttributes">
    @if (Items != null)
    {
        @foreach (var item in Items)
        {
            var isSelected = EqualityComparer<TValue>.Default.Equals(Value, item.Value);

            <button type="button"
                    role="radio"
                    aria-checked="@(isSelected ? "true" : "false")"
                    disabled="@(Disabled || item.Disabled)"
                    class="zak-segmented-item @(isSelected ? "zak-segmented-item-active" : "")"
                    @onclick="() => HandleSelect(item.Value)">
                @if (!string.IsNullOrEmpty(item.Icon))
                {
                    <ZakIcon Icon="@item.Icon" Size="ZakSize.Small" Style="margin-right: 6px;" />
                }
                <span>@item.Label</span>
            </button>
        }
    }
</div>

@code {
    [Parameter]
    public TValue? Value { get; set; }

    [Parameter]
    public EventCallback<TValue> ValueChanged { get; set; }

    [Parameter]
    public IReadOnlyList<ZakSegmentItem<TValue>>? Items { get; set; }

    [Parameter]
    public ZakColor Color { get; set; } = ZakColor.Primary;

    [Parameter]
    public ZakSize Size { get; set; } = ZakSize.Medium;

    [Parameter]
    public bool FullWidth { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public string AriaLabel { get; set; } = "Segmented control";

    private async Task HandleSelect(TValue value)
    {
        if (Disabled) return;
        Value = value;
        await ValueChanged.InvokeAsync(Value);
    }

    private string? CompiledClass => CreateClassBuilder("zak-segmented-control")
        .AddClass(Color.ToCssClass("zak-segmented"))
        .AddClass(Size.ToCssClass("zak-segmented"))
        .AddClass("zak-segmented-fullwidth", FullWidth)
        .AddClass("zak-segmented-disabled", Disabled)
        .Build();

    private string? CompiledStyle => CreateStyleBuilder().Build();
}
