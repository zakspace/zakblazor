@namespace ZAKBlazor
@using ZAKBlazor.Services
@using Microsoft.JSInterop
@inject IZakThemeService ThemeService
@inject IJSRuntime JS
@implements IDisposable

<style id="zak-theme-styles">
    @((MarkupString)_cssVariables)
</style>

@code {
    [Parameter]
    public ZakTheme? Theme { get; set; }

    [Parameter]
    public bool? DefaultDarkMode { get; set; }

    private string _cssVariables = string.Empty;

    protected override void OnInitialized()
    {
        if (Theme != null)
        {
            ThemeService.SetTheme(Theme);
        }

        Theme = ThemeService.CurrentTheme;

        if (DefaultDarkMode.HasValue && ThemeService.IsDarkMode != DefaultDarkMode.Value)
        {
            _ = ThemeService.SetDarkModeAsync(DefaultDarkMode.Value);
        }

        ThemeService.OnThemeChanged += HandleThemeChanged;
        ThemeService.OnCustomThemeChanged += HandleCustomThemeChanged;

        UpdateStyles();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var storedPref = await JS.InvokeAsync<string?>("zakBlazor.getStorageItem", "zak_dark_mode");
                if (storedPref != null && bool.TryParse(storedPref, out var isDark) && isDark != ThemeService.IsDarkMode)
                {
                    await ThemeService.SetDarkModeAsync(isDark);
                }
                else
                {
                    await JS.InvokeVoidAsync("zakBlazor.setTheme", ThemeService.IsDarkMode ? "dark" : "light");
                }
            }
            catch
            {
                // Ignore JS errors during prerendering or SSR
            }
        }
    }

    protected override void OnParametersSet()
    {
        if (Theme != null && Theme != ThemeService.CurrentTheme)
        {
            ThemeService.SetTheme(Theme);
        }
        UpdateStyles();
    }

    private void HandleThemeChanged(bool isDark)
    {
        UpdateStyles();
        InvokeAsync(StateHasChanged);
    }

    private void HandleCustomThemeChanged(ZakTheme theme)
    {
        Theme = theme;
        UpdateStyles();
        InvokeAsync(StateHasChanged);
    }

    private void UpdateStyles()
    {
        var currentTheme = Theme ?? ThemeService.CurrentTheme;
        _cssVariables = currentTheme.BuildCss(ThemeService.IsDarkMode);
    }

    public void Dispose()
    {
        ThemeService.OnThemeChanged -= HandleThemeChanged;
        ThemeService.OnCustomThemeChanged -= HandleCustomThemeChanged;
    }
}